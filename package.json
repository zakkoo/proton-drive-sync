{
  "name": "proton-drive-sync",
  "version": "0.3.1",
  "description": "Robust two-way sync between a local directory and Proton Drive",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "proton-drive-sync": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fault": "vitest run --project fault",
    "check": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "node scripts/gen-crypto-types.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/picomatch": "4.0.3",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "4.9.0",
    "globals": "16.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@protontech/crypto": "2.1.3",
    "@protontech/drive-sdk": "0.21.0",
    "dbus-next": "0.10.2",
    "picomatch": "4.0.7"
  }
}
